Content
</div>

<ul class="">
<li line-start="7" line-end="7">list item 1</li>
<li line-start="8" line-end="8">list item 2</li>
</ul>
<!--
Comment
-->
"
`;

exports[`marked spec: list_item_empty 1`] = `
"<ul class="">
<li line-start="1" line-end="2"><h2 style="position: relative;"><span style="position: absolute; top: -50px;" id="title"></span>title<a class="anchor octicon-link" href="#title"></a></h2>
</li>
</ul>
