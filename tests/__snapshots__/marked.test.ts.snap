</blockquote>
"
`;

exports[`marked spec: ordered_list_after_blockquote 1`] = `
"<ol class="">
<li line-start="1" line-end="1">test</li>
</ol>
<blockquote>
<p line-start="2" line-end="2">blockquote</p>
</blockquote>
<ol class="" start="2">
<li line-start="3" line-end="3">test</li>
</ol>
<blockquote>
<p line-start="4" line-end="4">blockquote</p>
</blockquote>
"
`;

