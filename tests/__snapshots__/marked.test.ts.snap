exports[`marked spec: empty_list_after_blockquote 1`] = `
"<blockquote>
<p line-start="1" line-end="1">foo</p>
</blockquote>
<ul class="">
<li line-start="2" line-end="2"></li>
</ul>
<blockquote>
<p line-start="4" line-end="5">foo
bar</p>
</blockquote>
<ol class="">
<li line-start="6" line-end="6"></li>
</ol>
"
`;

exports[`marked spec: html_following_list 1`] = `
"<ul class="">
<li line-start="1" line-end="1">list item 1</li>
<li line-start="2" line-end="2">list item 2</li>
</ul>
