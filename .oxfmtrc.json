{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".github", "tests/test.md", "tests/marked"],
  "printWidth": 100,
  "tabWidth": 3,
  "sortImports": {
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["*.json", "*.md"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
