{
  "name": "pantsdown",
  "version": "0.0.0",
  "description": "Markdown to 'GitHub HTML' parser",
  "license": "MIT",
  "author": "wallpants",
  "repository": {
    "type": "git",
    "url": "git://github.com/wallpants/pantsdown.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./*": "./*",
    "./styles.css": {
      "bun": "./src/css/styles.css",
      "import": "./src/css/styles.css"
    },
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "scripts": {
    "commit": "cz",
    "format": "oxfmt .",
    "typecheck": "tsc",
    "lint": "oxlint .",
    "check": "bun run typecheck && bun run lint",
    "docs:build": "bun run docs/build.ts"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@happy-dom/global-registrator": "^20.11.0",
    "@types/bun": "^1.3.14",
    "@types/katex": "^0.16.8",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.1",
    "inquirer": "^12.11.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.25.0",
    "semantic-release": "^25.0.8",
    "typescript": "7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
